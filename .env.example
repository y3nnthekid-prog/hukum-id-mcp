# Local API. Never commit real credentials.
NODE_ENV=development
PORT=3001
HUKUM_ALLOWED_ORIGINS=http://localhost:3000
HUKUM_CACHE_DIR=

# Microsoft Entra External ID (required in production).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Existing Azure Storage Account, accessed through Managed Identity/DefaultAzureCredential.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_KEY_VAULT_KEY_ID=
AZURE_CLIENT_ID=

# Optional Azure Monitor. Leave empty locally to keep exporters disabled.
APPLICATIONINSIGHTS_CONNECTION_STRING=
APPLICATIONINSIGHTS_AUTHENTICATION_STRING=

# Optional platform AI quota. BYOK can be supplied per request and is never persisted.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public web configuration.
NEXT_PUBLIC_HUKUM_API_URL=http://localhost:3001
