{
  "name": "hukum-id-mcp",
  "version": "0.6.0",
  "description": "MCP server untuk riset hukum Indonesia dan hukum ekonomi syariah: peraturan (JDIH BPK), putusan MA & MK, PERMA/SEMA, fatwa DSN-MUI, ayat, hadis berderajat, kitab turats, dan literatur akademik.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/y3nnthekid-prog/hukum-id-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y3nnthekid-prog/hukum-id-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/y3nnthekid-prog/hukum-id-mcp/issues"
  },
  "workspaces": [
    "web"
  ],
  "bin": {
    "hukum-id-mcp": "dist/mcp/stdio.js"
  },
  "main": "dist/mcp/stdio.js",
  "types": "dist/core/contracts.d.ts",
  "files": [
    "dist/",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/mcp/stdio.ts",
    "start:legacy": "node src/server.js",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:web": "npm run dev --workspace hukum-id-web",
    "start:api": "tsx src/api/server.ts",
    "start:api:prod": "node --import @azure/monitor-opentelemetry/loader dist/api/bootstrap.js",
    "build:web": "npm run build --workspace hukum-id-web",
    "lint": "eslint src/**/*.ts test/**/*.ts web/**/*.ts web/**/*.tsx",
    "lint:api": "redocly lint openapi.yaml --skip-rule no-server-example.com",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run test:unit",
    "test:unit": "node test/trust-foundation.test.js && node test/abstain.test.js && node test/parser.test.js && node --import tsx --test test/cache.test.ts test/core-contract.test.ts test/core-service.test.ts test/ai-synthesis.test.ts test/api.test.ts test/auth.test.ts test/upload-storage.test.ts test/evidence-store.test.ts test/index-release.test.ts test/web-client.test.ts test/mcp-contract.test.ts test/remote-mcp.test.ts test/telemetry.test.ts",
    "test:abstain": "node test/abstain.test.js",
    "test:load": "node --import tsx --test test/load.test.ts",
    "test:parser": "node test/parser.test.js",
    "smoke": "node test/smoke.js",
    "snapshot": "node scripts/bangun-snapshot.js",
    "snapshot:ringkas": "node scripts/bangun-snapshot.js --ringkas",
    "sweep:uploads": "tsx src/workers/sweep-uploads.ts",
    "verify": "npm run lint && npm run lint:api && npm test && npm run typecheck && npm run build && npm run build:web",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hukum",
    "indonesia",
    "indonesian-law",
    "legal-research",
    "hukum-ekonomi-syariah",
    "islamic-economic-law",
    "sharia",
    "jdih",
    "mahkamah-konstitusi",
    "mahkamah-agung",
    "dsn-mui",
    "fatwa"
  ],
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "^4.13.2",
    "@azure/keyvault-keys": "^4.10.2",
    "@azure/monitor-opentelemetry": "^1.19.0",
    "@azure/storage-blob": "^12.33.0",
    "@azure/storage-queue": "^12.31.0",
    "@google/genai": "^2.21.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@opentelemetry/api": "^1.9.0",
    "hono": "^4.11.4",
    "ipaddr.js": "^1.9.1",
    "jose": "^6.2.11",
    "pdfjs-dist": "^4.10.38",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.51.2",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0"
  }
}
