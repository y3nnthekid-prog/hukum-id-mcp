{
  "name": "hukum-id-mcp",
  "version": "0.6.0",
  "description": "MCP server untuk riset hukum Indonesia dan hukum ekonomi syariah: peraturan (JDIH BPK), putusan MA & MK, PERMA/SEMA, fatwa DSN-MUI, ayat, hadis berderajat, kitab turats, dan literatur akademik.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "hukum-id-mcp": "src/server.js"
  },
  "main": "src/server.js",
  "files": [
    "src/",
    "scripts/",
    "test/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "npm run test:unit",
    "test:unit": "node test/trust-foundation.test.js && node test/parser.test.js",
    "test:parser": "node test/parser.test.js",
    "smoke": "node test/smoke.js",
    "snapshot": "node scripts/bangun-snapshot.js",
    "snapshot:ringkas": "node scripts/bangun-snapshot.js --ringkas",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hukum",
    "indonesia",
    "indonesian-law",
    "legal-research",
    "hukum-ekonomi-syariah",
    "islamic-economic-law",
    "sharia",
    "jdih",
    "mahkamah-konstitusi",
    "mahkamah-agung",
    "dsn-mui",
    "fatwa"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ipaddr.js": "^1.9.1",
    "pdfjs-dist": "^4.10.38",
    "zod": "^4.5.4"
  }
}
